        <mxCell id="forklbl" parent="1" style="text;html=1;align=center;fontSize=10.5;fontColor=#666666;" value="runs in parallel &#8212; one send, two destinations" vertex="1"><mxGeometry height="20" width="360" x="320" y="692" as="geometry" /></mxCell>
