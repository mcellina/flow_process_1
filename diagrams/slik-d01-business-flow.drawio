  <diagram name="D01 Business Process Flow" id="d01bizflow1">
    <mxGraphModel dx="1683" dy="697" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1084" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
                <mxCell id="start" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;" value="START" vertex="1"><mxGeometry height="50" width="240" x="380" y="110" as="geometry" /></mxCell>
