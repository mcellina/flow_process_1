        <mxCell id="step1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;spacingLeft=14;strokeColor=#2563EB;strokeWidth=2;" value="&lt;font style='font-size:9px;color:#2563EB'&gt;&lt;b&gt;IFIN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;1. Retrieve CIF / NIK&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;Retrieve CIF / NIK from iFin as the reference to build Form D01&lt;/font&gt;" vertex="1"><mxGeometry height="72" width="520" x="240" y="200" as="geometry" /></mxCell>
        <mxCell id="e-step1-step2" edge="1" parent="1" source="step1" target="step2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="step2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;spacingLeft=14;strokeColor=#059669;strokeWidth=2;" value="&lt;font style='font-size:9px;color:#059669'&gt;&lt;b&gt;MIS &#8226; SOURCE: CONFINS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;2. Extract &amp; Filter Form D01 Data&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;Pull debtor details (name, address, etc.) from Confins using the CIF from step 1&lt;/font&gt;" vertex="1"><mxGeometry height="72" width="520" x="240" y="302" as="geometry" /></mxCell>
        <mxCell id="e-step2-step3" edge="1" parent="1" source="step2" target="step3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="step3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;spacingLeft=14;strokeColor=#059669;strokeWidth=2;" value="&lt;font style='font-size:9px;color:#059669'&gt;&lt;b&gt;MIS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;3. Store to D01_staging&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;Save debtor detail data to the MIS database, table D01_staging&lt;/font&gt;" vertex="1"><mxGeometry height="72" width="520" x="240" y="404" as="geometry" /></mxCell>
        <mxCell id="e-step3-step4" edge="1" parent="1" source="step3" target="step4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell>
